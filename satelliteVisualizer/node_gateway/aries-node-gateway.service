[Unit]
Description=ARIES SSA Satellite Visualizer Node Gateway
After=network.target aries-propagation.service

[Service]
Type=simple
User=user
WorkingDirectory=/home/user/Desktop/file-portal/satelliteVisualizer/node_gateway
ExecStart=/home/user/.nvm/versions/node/v24.14.1/bin/node server.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
